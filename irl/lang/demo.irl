// IRL™ 2.1 — the .irl language, professional edition.
// A complete little program: roster + stats + memoized fib.

import math

function shout(word) {
    return word.upper()
}

var people = ["anika", "sam", "kim"]
var ages = {"anika": 24, "sam": 19, "kim": 15}

for (name in people) {
    var age = ages[name]
    var tag = "minor"
    if (age >= 18) {
        tag = "adult"
    } elif (age >= 13) {
        tag = "teen"
    }
    print(f"{shout(name)}: {age} ({tag})")
}

var scores = [91, 77, 85, 100]
print("stats:", sum(scores), max(scores), round(sum(scores) / len(scores), 1))
print("sqrt(144) =", math.sqrt(144))
print("sliced:", scores[1:3], "100 in scores:", 100 in scores)

memo function fib(n) {
    if (n < 2) {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}
print("fib(30) =", fib(30))

// legacy slang still runs on 2.1 (aliases of the standard keywords):
task old_school(word) {
    spill(word)
}
old_school("(legacy syntax runs fine)")
